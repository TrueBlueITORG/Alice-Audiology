{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "js/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Archivo|Mulish))/i]",
        "message": "Font not provided by the design system. Available: Archivo, Mulish."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
  ],
  "x-omelette": {
    "components": {},
    "tokens": [
      "--bg-dark-1",
      "--bg-dark-2",
      "--blue",
      "--color-grey-slate",
      "--color-teal-bright",
      "--color-teal-deep",
      "--color-teal-electric",
      "--ease",
      "--green",
      "--ink",
      "--ink-3",
      "--line",
      "--maxw",
      "--paper",
      "--paper-2",
      "--paper-3",
      "--radius",
      "--radius-sm",
      "--red",
      "--shadow-lg",
      "--shadow-md",
      "--shadow-sm",
      "--teal",
      "--text",
      "--text-faint",
      "--text-light",
      "--text-soft"
    ],
    "tokenKinds": {
      "--ink": "color",
      "--bg-dark-1": "color",
      "--bg-dark-2": "color",
      "--ink-3": "color",
      "--paper": "color",
      "--paper-2": "color",
      "--paper-3": "color",
      "--line": "color",
      "--text": "font",
      "--text-soft": "font",
      "--color-grey-slate": "color",
      "--text-light": "font",
      "--text-faint": "font",
      "--teal": "color",
      "--color-teal-electric": "color",
      "--color-teal-bright": "color",
      "--color-teal-deep": "color",
      "--blue": "color",
      "--green": "color",
      "--red": "color",
      "--shadow-sm": "shadow",
      "--shadow-md": "shadow",
      "--shadow-lg": "shadow",
      "--radius": "radius",
      "--radius-sm": "radius",
      "--maxw": "spacing",
      "--ease": "other"
    },
    "fontFamilies": [
      "Archivo",
      "Mulish"
    ]
  }
}